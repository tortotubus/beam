<!-- Geometry, Material, Anchor and Direction use the shared Huang declarations. -->
<!ELEMENT BendingRodSegmentsImplicit
  (Geometry, Material, RodInitialLine, RodBoundary, Gravity?, ImplicitSolver?)>
<!ELEMENT RodInitialLine (Anchor, Direction)>
<!ELEMENT RodBoundary EMPTY>
<!ATTLIST RodBoundary type (pinned|free) #REQUIRED>
<!ELEMENT Gravity EMPTY>
<!ATTLIST Gravity x CDATA #REQUIRED y CDATA #REQUIRED z CDATA "0">
<!ELEMENT ImplicitSolver EMPTY>
<!ATTLIST ImplicitSolver
  spectralRadius CDATA "0.8"
  nonlinearTolerance CDATA "1e-9"
  maxIterations CDATA "20">
