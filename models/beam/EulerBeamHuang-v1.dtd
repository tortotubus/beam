<!-- XML contract for EulerBeamHuang; semantic checks live in EulerBeamHuangXML.cpp. -->
<!ELEMENT EulerBeamHuang
  (Geometry, Material, InitialLine, BoundaryConditions)>

<!ELEMENT Geometry EMPTY>
<!ATTLIST Geometry
  length CDATA #REQUIRED
  nodes CDATA #REQUIRED>

<!ELEMENT Material EMPTY>
<!ATTLIST Material
  bendingRigidity CDATA #REQUIRED
  linearDensity CDATA #REQUIRED>

<!ELEMENT InitialLine (Anchor, Direction)>
<!ATTLIST InitialLine anchorEnd (left|right) #REQUIRED>

<!ELEMENT Anchor EMPTY>
<!ATTLIST Anchor
  x CDATA #REQUIRED
  y CDATA #REQUIRED
  z CDATA "0">

<!ELEMENT Direction EMPTY>
<!ATTLIST Direction
  x CDATA #REQUIRED
  y CDATA #REQUIRED
  z CDATA "0">

<!ELEMENT BoundaryConditions EMPTY>
<!ATTLIST BoundaryConditions
  left (free|simple|clamped) #REQUIRED
  right (free|simple|clamped) #REQUIRED>
