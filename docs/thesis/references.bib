@article{uhlmann_immersed_2005,
	title = {An Immersed Boundary Method with Direct Forcing for the Simulation of Particulate Flows},
	volume = {209},
	issn = {00219991},
	url = {http://arxiv.org/abs/1809.08170},
	doi = {10.1016/j.jcp.2005.03.017},
	abstract = {We present an improved method for computing incompressible viscous ﬂow around suspended rigid particles using a ﬁxed and uniform computational grid. The main idea is to incorporate Peskin’s regularized delta function approach [Acta Numerica 11 (2002) 1] into a direct formulation of the ﬂuid-solid interaction force in order to allow for a smooth transfer between Eulerian and Lagrangian representations while at the same time avoiding strong restrictions of the time step. This technique was implemented in a ﬁnite-diﬀerence and fractional-step context. A variety of two- and three-dimensional simulations are presented, ranging from the ﬂow around a single cylinder to the sedimentation of 1000 spherical particles. The accuracy and eﬃciency of the current method are clearly demonstrated.},
	pages = {448--476},
	number = {2},
	journaltitle = {Journal of Computational Physics},
	shortjournal = {Journal of Computational Physics},
	author = {Uhlmann, Markus},
	urldate = {2025-04-10},
	date = {2005-11},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {1809.08170 [physics]},
	keywords = {Physics - Computational Physics, Physics - Fluid Dynamics},
	file = {PDF:/home/colive/Zotero/storage/3XUDBCK3/Uhlmann - 2005 - An Immersed Boundary Method with Direct Forcing for the Simulation of Particulate Flows.pdf:application/pdf},
}

@article{bourgat_large_1980,
	title = {Large Displacement Calculations of Flexible Pipelines by Finite Element and Nonlinear Programming Methods},
	volume = {1},
	issn = {0196-5204, 2168-3417},
	url = {http://epubs.siam.org/doi/10.1137/0901003},
	doi = {10.1137/0901003},
	abstract = {We describe in this paper the application of some nonlinear programming and finite element methods to the calculation of the large displacements of inextensible and flexible pipelines. The difficulties related to the inextensibility of the pipelines are treated by introducing an appropriate augmented Lagrangian and then using a special algorithm closely related to alternate direction methods. Static and dynamic calculations are discussed and several numerical applications are presented.},
	pages = {34--81},
	number = {1},
	journaltitle = {{SIAM} Journal on Scientific and Statistical Computing},
	shortjournal = {{SIAM} J. Sci. and Stat. Comput.},
	author = {Bourgat, J. F. and Dumay, J. M. and Glowinski, R.},
	urldate = {2025-03-10},
	date = {1980-03},
	langid = {english},
	file = {PDF:/home/colive/Zotero/storage/3KB68G22/Bourgat et al. - 1980 - Large Displacement Calculations of Flexible Pipelines by Finite Element and Nonlinear Programming Me.pdf:application/pdf},
}

@article{huang_simulation_2007,
	title = {Simulation of flexible filaments in a uniform flow by the immersed boundary method},
	volume = {226},
	rights = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {00219991},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0021999107003051},
	doi = {10.1016/j.jcp.2007.07.002},
	abstract = {An improved version of the immersed boundary ({IB}) method is developed for simulating ﬂexible ﬁlaments in a uniform ﬂow. The proposed {IB} method is based on an eﬃcient Navier–Stokes solver adopting the fractional step method and a staggered Cartesian grid system. The ﬂuid motion deﬁned on an Eulerian grid and the ﬁlament motion deﬁned on a Lagrangian grid are independently solved and their interaction force is explicitly calculated using a feedback law. A direct numerical method is developed to calculate the ﬁlament motion under the constraint of inextensibility. When applied to the case of a swinging ﬁlament analogous to a rope pendulum, the proposed method gave results very similar to those of the analytical solution derived using the perturbation method. For a ﬂexible ﬁlament ﬂapping in a uniform ﬂow, the mechanism by which small vortex processions are produced was investigated. The bistable property of the system was observed by altering the ﬁlament length, and the eﬀects of the boundary condition at the ﬁxed end (simply supported or clamped) were studied. For two side-by-side ﬁlaments in a uniform ﬂow, both in-phase ﬂapping and out-of-phase ﬂapping were reproduced in the present simulations. A repulsive force was included in the formulation to handle collisions between the free ends of side-by-side ﬁlaments undergoing out-of-phase ﬂapping.},
	pages = {2206--2228},
	number = {2},
	journaltitle = {Journal of Computational Physics},
	shortjournal = {Journal of Computational Physics},
	author = {Huang, Wei-Xi and Shin, Soo Jai and Sung, Hyung Jin},
	urldate = {2024-11-16},
	date = {2007-10},
	langid = {english},
	file = {PDF:/home/colive/Zotero/storage/ILV2UACB/Huang et al. - 2007 - Simulation of flexible filaments in a uniform flow by the immersed boundary method.pdf:application/pdf},
}

