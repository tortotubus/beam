@article{uhlmann_immersed_2005,
	title = {An Immersed Boundary Method with Direct Forcing for the Simulation of Particulate Flows},
	volume = {209},
	issn = {00219991},
	url = {http://arxiv.org/abs/1809.08170},
	doi = {10.1016/j.jcp.2005.03.017},
	abstract = {We present an improved method for computing incompressible viscous ﬂow around suspended rigid particles using a ﬁxed and uniform computational grid. The main idea is to incorporate Peskin’s regularized delta function approach [Acta Numerica 11 (2002) 1] into a direct formulation of the ﬂuid-solid interaction force in order to allow for a smooth transfer between Eulerian and Lagrangian representations while at the same time avoiding strong restrictions of the time step. This technique was implemented in a ﬁnite-diﬀerence and fractional-step context. A variety of two- and three-dimensional simulations are presented, ranging from the ﬂow around a single cylinder to the sedimentation of 1000 spherical particles. The accuracy and eﬃciency of the current method are clearly demonstrated.},
	pages = {448--476},
	number = {2},
	journaltitle = {Journal of Computational Physics},
	shortjournal = {Journal of Computational Physics},
	author = {Uhlmann, Markus},
	urldate = {2025-04-10},
	date = {2005-11},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {1809.08170 [physics]},
	keywords = {Physics - Fluid Dynamics, Physics - Computational Physics},
	file = {PDF:/home/colive/Zotero/storage/3XUDBCK3/Uhlmann - 2005 - An Immersed Boundary Method with Direct Forcing for the Simulation of Particulate Flows.pdf:application/pdf},
}

@article{bourgat_large_1980,
	title = {Large Displacement Calculations of Flexible Pipelines by Finite Element and Nonlinear Programming Methods},
	volume = {1},
	issn = {0196-5204, 2168-3417},
	url = {http://epubs.siam.org/doi/10.1137/0901003},
	doi = {10.1137/0901003},
	abstract = {We describe in this paper the application of some nonlinear programming and finite element methods to the calculation of the large displacements of inextensible and flexible pipelines. The difficulties related to the inextensibility of the pipelines are treated by introducing an appropriate augmented Lagrangian and then using a special algorithm closely related to alternate direction methods. Static and dynamic calculations are discussed and several numerical applications are presented.},
	pages = {34--81},
	number = {1},
