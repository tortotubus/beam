	keywords = {Physics - Computational Physics, Astrophysics},
	file = {PDF:/home/colive/Zotero/storage/YANCNQNW/Khokhlov - 1998 - Fully Threaded Tree for Adaptive Refinement Fluid Dynamics Simulations.pdf:application/pdf},
