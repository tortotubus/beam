@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@ELFF_USE_MPI@)
  find_dependency(MPI COMPONENTS C)
endif()

if(@ELFF_USE_HDF5@)
  if(@ELFF_USE_MPI@)
    set(HDF5_PREFER_PARALLEL TRUE)
  endif()
  find_package(HDF5 COMPONENTS C HL REQUIRED)
endif()

if(@ELFF_USE_EIGEN3@)
  find_package(Eigen3 REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ELFFTargets.cmake")

check_required_components(ELFF)
