<!-- Basilisk-owned configuration for the flapping_fibre case. -->
<!ELEMENT Basilisk
  (Domain, Time, Fluid, Grid, ImmersedBoundary, Output)>
<!ATTLIST Basilisk
  schemaVersion (1) #REQUIRED
  caseType (flapping_fibre) #REQUIRED>

<!ELEMENT Domain EMPTY>
<!ATTLIST Domain
  size CDATA #REQUIRED
  originX CDATA #REQUIRED
  originY CDATA #REQUIRED
  originZ CDATA "0">

<!ELEMENT Time EMPTY>
<!ATTLIST Time
  step CDATA #REQUIRED
  end CDATA #REQUIRED>

<!ELEMENT Fluid (InletVelocity)>
<!ATTLIST Fluid
  density CDATA #REQUIRED
  dynamicViscosity CDATA #REQUIRED>

<!ELEMENT InletVelocity EMPTY>
<!ATTLIST InletVelocity
  x CDATA #REQUIRED
  y CDATA #REQUIRED
  z CDATA "0">

<!ELEMENT Grid EMPTY>
<!ATTLIST Grid
  minLevel CDATA #REQUIRED
  maxLevel CDATA #REQUIRED>

<!ELEMENT ImmersedBoundary (UniformForceDensity?)>
<!ATTLIST ImmersedBoundary
  level CDATA #REQUIRED
  ownerRank CDATA #REQUIRED>

<!ELEMENT UniformForceDensity EMPTY>
<!ATTLIST UniformForceDensity
  x CDATA #REQUIRED
  y CDATA #REQUIRED
  z CDATA "0">

<!ELEMENT Output EMPTY>
<!ATTLIST Output
  directory CDATA #REQUIRED
  interval CDATA #REQUIRED>
