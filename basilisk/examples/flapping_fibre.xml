<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Case SYSTEM "../../io/DTD/ELFF/ELFF-v2.dtd">
<Case formatVersion="2" dimension="2">
  <!-- Huang, Shin & Sung (2007), Fig. 13; doi:10.1016/j.jcp.2007.07.002. -->
  <Parameters>
    <Parameter name="Re" value="200"/>
    <Parameter name="gamma" value="0.001"/>
    <Parameter name="rho" value="1.5"/>
    <Parameter name="Fr" value="0.5"/>
  </Parameters> 
  <ELFF>
    <Models distribution="rank0">
      <BendingRodSegments>
        <Geometry length="1" nodes="65"/>
        <InitialCondition>
          <Line anchorEnd="right">
            <Anchor x="0" y="0" z="0"/>
            <Direction x="0.9510565163" y="0.3090169944" z="0"/>
          </Line>
        </InitialCondition>
        <Material>
          <BendingRigidity>${rho*gamma}</BendingRigidity>
          <LinearDensity>${rho}</LinearDensity>
        </Material>
        <BendingRodBoundary end="left" type="free"/>
        <BendingRodBoundary end="right" type="pinned"/>
      </BendingRodSegments>
    </Models>
  </ELFF>
  <Basilisk caseType="flapping_fibre">
    <Time step="0.0003" end="50"/>
    <Fluid>
      <FluidMaterial><Density>1</Density><DynamicViscosity>${1/Re}</DynamicViscosity></FluidMaterial>
      <FluidBoundaryCondition field="u.x" direction="left" type="dirichlet">
        <Value>1</Value>
      </FluidBoundaryCondition>
      <FluidBoundaryCondition field="u.y" direction="left" type="dirichlet">
        <Value>0</Value>
      </FluidBoundaryCondition>
      <FluidBoundaryCondition field="p" direction="left" type="neumann">
        <Value>0</Value>
      </FluidBoundaryCondition>
      <FluidBoundaryCondition field="pf" direction="left" type="neumann">
        <Value>0</Value>
      </FluidBoundaryCondition>
      <FluidBoundaryCondition field="u.x" direction="right" type="neumann">
        <Value>0</Value>
      </FluidBoundaryCondition>
      <FluidBoundaryCondition field="p" direction="right" type="dirichlet">
        <Value>0</Value>
      </FluidBoundaryCondition>
      <FluidBoundaryCondition field="pf" direction="right" type="dirichlet">
        <Value>0</Value>
      </FluidBoundaryCondition>
    </Fluid>
    <Grid type="quadtree">
      <Origin x="-2" y="-8" z="0"/>
      <Length>16</Length>
      <Depth>6</Depth>
      <AdaptWavelet minLevel="6" maxLevel="10" enable="true">
        <VectorField name="u" tolerance="0.005"/>
      </AdaptWavelet>
    </Grid>
    <Restart enable="true"/>
    <ImmersedBoundary level="11">
      <ForceCoupled>
        <Iterations>2</Iterations>
        <Relaxation>1</Relaxation>
      </ForceCoupled>
      <ImmersedBoundaryKernel type="Cosine"/>
      <UniformForceDensity x="${rho*Fr}" y="0" z="0"/>
    </ImmersedBoundary>
    <Output directory="flapping_fibre_output">
      <FluidOutput enable="true">
        <SimulationTime step="0.05"/>
        <ScalarField name="omega"/>
        <ScalarField name="p"/>
        <VectorField name="u"/>
        <VectorField name="ibmf"/>
      </FluidOutput>
      <SolidOutput enable="true">
        <SimulationTime step="0.05"/>
        <IBVectorField name="eulvel"/>
        <IBVectorField name="nforce"/>
        <IBVectorField name="nvel"/>
      </SolidOutput>
      <Checkpoint enable="true"/>
    </Output>
  </Basilisk>
</Case>
