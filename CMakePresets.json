{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 12,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Default",
      "displayName": "Default (Release)",
      "description": "Release build with system default generator.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/release",
        "ELFF_BUILD_DOC": "On",
        "ELFF_BUILD_TESTS": "On"
      }
    },
    {
      "name": "Debug",
      "displayName": "Debug",
      "description": "Build with debug info and no optimization.",
      "inherits": "Default",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/debug",
        "ELFF_BUILD_DOC": "On",
        "ELFF_BUILD_TESTS": "On",
        "ELFF_USE_COVERAGE": "On"
      }
    },
    {
      "name": "SockeyeRelease",
      "displayName": "HPC Release for Sockeye",
      "description": "Release build for Sockeye with specific compiler and flags.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/sockeye_release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/sockeye_release",
      	"CMAKE_SKIP_INSTALL_RPATH": "FALSE",
	      "CMAKE_INSTALL_RPATH": "${sourceDir}/install/sockeye_release/lib64",
        "CMAKE_INSTALL_RPATH_USE_LINK_PATH": "TRUE",
        "ELFF_USE_SUBMODULES": "ON",
        "ELFF_BUILD_THIRD_PARTY_BASILISK": "ON",
	      "ELFF_BUILD_DOC": "OFF",
        "ELFF_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "r8k1",
      "displayName": "r8k1",
      "description": "Release build with system default generator.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/r8k1",
      "environment": {
        "CC": "/media/data/labdata/colive/.nix-profile/bin/gcc",
        "CXX": "/media/data/labdata/colive/.nix-profile/bin/g++",
        "MPICXX": "/media/data/labdata/colive/.nix-profile/bin/mpicxx",
        "MPICC": "/media/data/labdata/colive/.nix-profile/bin/mpicc",
        "PATH": "/media/data/labdata/colive/.nix-profile/bin:/usr/bin",
        "LD_LIBRARY_PATH": "/media/data/labdata/colive/.nix-profile/lib"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/r8k1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Default",
      "configurePreset": "Default",
      "description": "Build the release configuration",
      "jobs": 16
    },
    {
      "name": "Debug",
      "configurePreset": "Debug",
      "description": "Build the debug configuration",
      "jobs": 16
    },
    {
      "name": "SockeyeRelease",
      "configurePreset": "SockeyeRelease",
      "description": "Build on Sockeye",
      "jobs": 8
    },
    {
      "name": "r8k1",
      "configurePreset": "r8k1",
      "description": "Build on r8k1",
      "jobs": 8
    }
  ],
  "testPresets": [
    {
      "name": "Default",
      "configurePreset": "Default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Debug",
      "configurePreset": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
